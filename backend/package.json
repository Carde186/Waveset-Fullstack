{
    "name": "waveset-backend",
    "version": "1.0.0",
    "private": true,
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "node --env-file=../.env.test --test --test-concurrency=1 \"test/**/*.test.js\"",
        "admin:crea": "node scripts/creaAdmin.js",
        "eventi:immagini": "node scripts/backfillImmaginiTicketmaster.js",
        "eventi:sync": "node scripts/sincronizzaTicketmaster.js",
        "eventi:scheduler": "node scripts/sincronizzaTicketmaster.js --continuo",
        "artisti:provider-schema": "node scripts/preparaProviderArtisti.js --applica",
        "eventi:ollama-schema": "node scripts/preparaOllama.js --applica",
        "eventi:valida": "node scripts/validaEventiOllama.js",
        "eventi:validazione-worker": "node scripts/validaEventiOllama.js --continuo",
        "ollama:check": "node scripts/validaEventiOllama.js --check",
        "catalogo:classifica": "node scripts/classificaArtisti.js"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "mysql2": "^3.11.0"
    },
    "devDependencies": {
        "nodemon": "^3.1.4"
    }
}
