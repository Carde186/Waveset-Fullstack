# Ambiente NORMALE (docker-compose.yml, progetto waveset-fullstack).
# Copia in .env e compila; .env non va versionato.
DB_NAME=waveset
DB_USER=waveset
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=3002
# Unico account predisposto (ADMIN), creato da scripts/creaAdmin.js.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Admin
TICKETMASTER_API_KEY=
GOOGLE_GEOCODING_API_KEY=
# Facoltative, non richieste per avviare: SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET
# Rate limit (facoltativi, finestre di 900 s = 15 minuti). Se assenti o vuoti
# valgono i valori normali qui sotto; docker-compose.yml li inoltra al backend.
# Un valore non valido (non intero >= 1) ferma l'avvio del backend.
#   Registrazione: richieste per IP
#   RATE_LIMIT_REGISTRAZIONE_MAX=30
#   RATE_LIMIT_REGISTRAZIONE_FINESTRA_SEC=900
#   Login: fallimenti per IP+email, fallimenti per IP, tentativi totali per IP
#   RATE_LIMIT_LOGIN_COPPIA_MAX=10
#   RATE_LIMIT_LOGIN_IP_FALLIMENTI_MAX=50
#   RATE_LIMIT_LOGIN_IP_TOTALE_MAX=100
#   RATE_LIMIT_LOGIN_FINESTRA_SEC=900

# Sincronizzazione automatica eventi: chiave solo backend, mai VITE_.
# Worker avviato da Compose; controlla il calendario ogni 8 ore per artista.
# TICKETMASTER_SYNC_ENABLED=true
# TICKETMASTER_SYNC_INTERVAL_SEC=28800
# TICKETMASTER_SYNC_STALE_SEC=86400
# TICKETMASTER_SYNC_MAX_ARTISTS=50
# TICKETMASTER_SYNC_MAX_PAGES=4
# TICKETMASTER_SYNC_MAX_REQUESTS=300
# TICKETMASTER_SYNC_TIMEOUT_MS=10000
