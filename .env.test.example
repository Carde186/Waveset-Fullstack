# Ambiente di TEST (docker-compose.test.yml, progetto waveset-test).
# Copia in .env.test; non va versionato. Niente DB_HOST/DB_PORT/DB_NAME:
# il DB di test è fisso (waveset_test) e host/porta li imposta preparaAmbiente.js.
DB_USER=waveset_test
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3308
BACKEND_HOST_PORT=3001
# Frontend di test: si apre su http://localhost:<porta>. La stessa porta
# diventa l'origine ammessa dal backend (FRONTEND_ORIGINS).
# Il frontend browser test è opzionale (--profile browser), separato dallo sviluppo.
FRONTEND_HOST_PORT=5175
# Facoltative per la mappa: chiave browser ristretta e Map ID JavaScript.
# Senza entrambe, la lista eventi resta disponibile senza mappa.
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=
# Facoltativa, solo per provare il 503 "sessione web non configurata":
# impostata vuota il backend di test disabilita la sessione browser.
# FRONTEND_ORIGINS_TEST=
# Facoltative: soglie del rate limit SOLO per il backend di test. Se assenti il
# Compose di test usa i valori alti qui sotto (i valori normali sono: registrazione
# 30 per IP; login 10 fallimenti per IP+email, 50 fallimenti e 100 tentativi
# totali per IP; finestra 900 s). I limitatori veri si provano a parte, con
# soglie basse iniettate nei test.
# RATE_LIMIT_REGISTRAZIONE_MAX=1000
# RATE_LIMIT_REGISTRAZIONE_FINESTRA_SEC=900
# RATE_LIMIT_LOGIN_COPPIA_MAX=1000
# RATE_LIMIT_LOGIN_IP_FALLIMENTI_MAX=1000
# RATE_LIMIT_LOGIN_IP_TOTALE_MAX=10000
# RATE_LIMIT_LOGIN_FINESTRA_SEC=900

# Sincronizzazione automatica eventi: chiave solo backend, mai VITE_.
# TICKETMASTER_API_KEY=
# Worker avviato da Compose; controlla il calendario ogni 8 ore per artista.
# TICKETMASTER_SYNC_ENABLED=true
# TICKETMASTER_SYNC_INTERVAL_SEC=28800
# TICKETMASTER_SYNC_STALE_SEC=86400
# TICKETMASTER_SYNC_MAX_ARTISTS=50
# TICKETMASTER_SYNC_MAX_PAGES=4
# TICKETMASTER_SYNC_MAX_REQUESTS=300
# TICKETMASTER_SYNC_TIMEOUT_MS=10000

# Catalogo artisti solo backend: deezer (default, senza chiave) oppure apple_music.
ARTISTI_PROVIDER=deezer
DEEZER_TIMEOUT_MS=8000

# Apple Music Catalog API: alternativa opzionale, solo backend.
# TEAM_ID e KEY_ID sono gli identificatori Apple a 10 caratteri (non usare variabili VITE_*).
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# PEM .p8 racchiuso tra apici singoli: newline reali o sequenze letterali \n.
APPLE_MUSIC_PRIVATE_KEY=
# Obbligatorio quando Apple è configurato: codice storefront, per esempio it.
APPLE_MUSIC_STOREFRONT=it
# Secondi: 60..15777000; rinnovo automatico anticipato di 30 secondi.
APPLE_MUSIC_TOKEN_TTL=3600
APPLE_MUSIC_TIMEOUT_MS=10000

# Ollama backend: Mac nativo usa http://localhost:11434; Docker macOS usa host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=45000
OLLAMA_SOGLIA_CONFIDENZA=0.85
OLLAMA_MAX_TENTATIVI=3
OLLAMA_CONCORRENZA=1
OLLAMA_INTERVALLO_MS=30000
OLLAMA_LOTTO=20
